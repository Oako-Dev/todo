{
    "openapi": "3.0.0",
    "info": {
        "title": "TODO API",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "https://api.todo.daytonellwanger.com"
        }
    ],
    "paths": {
        "/todos/{id}": {
            "get": {
                "summary": "Gets the TODO list.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "ID of the TODO list."
                    },
                    {
                        "in": "header",
                        "name": "X-Todo-Password",
                        "schema": {
                            "type": "string"
                        },
                        "required": false,
                        "description": "Password for accessing a password-protected TODO list."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully fetched TODO list.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TodoList"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Password required or incorrect.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PasswordRequiredError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "TODO list not found."
                    }
                }
            },
            "put": {
                "summary": "Updates the TODO list.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string"
                        },
                        "required": true,
                        "description": "ID of the TODO list."
                    },
                    {
                        "in": "header",
                        "name": "X-Todo-Password",
                        "schema": {
                            "type": "string"
                        },
                        "required": false,
                        "description": "Password for updating a password-protected TODO list."
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TodoList"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successfully updated TODO list.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TodoList"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Password required or incorrect.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PasswordRequiredError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "TodoListItem": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "completed": {
                        "type": "boolean"
                    }
                },
                "required": ["text", "completed"]
            },
            "TodoList": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "list": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TodoListItem"
                        }
                    },
                    "isProtected": {
                        "type": "boolean",
                        "description": "Whether this list currently has a password set. Only meaningful in responses; ignored if sent in a request."
                    },
                    "password": {
                        "type": "string",
                        "nullable": true,
                        "description": "Only used when updating a list. Set to a non-empty string to protect the list or change its password, to null or an empty string to remove password protection, or omit to leave protection unchanged. Never returned in responses."
                    }
                },
                "required": ["id", "list"]
            },
            "PasswordRequiredError": {
                "type": "object",
                "properties": {
                    "isProtected": {
                        "type": "boolean"
                    }
                },
                "required": ["isProtected"]
            }
        }
    }
}
